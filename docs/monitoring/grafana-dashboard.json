{
  "dashboard": {
    "id": null,
    "title": "Fingerprint Library Metrics",
    "tags": ["fingerprint", "tls", "security"],
    "timezone": "utc",
    "schemaVersion": 36,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Fingerprint Generation Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(fingerprint_generation_total[5m])",
            "legendFormat": "{{browser}}/{{os}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        }
      },
      {
        "id": 2,
        "title": "Generation Duration (p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(fingerprint_generation_duration_ms_bucket[5m]))",
            "legendFormat": "p99 {{browser}}"
          },
          {
            "expr": "histogram_quantile(0.95, rate(fingerprint_generation_duration_ms_bucket[5m]))",
            "legendFormat": "p95 {{browser}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "yAxes": [
          {
            "label": "Duration (ms)",
            "min": 0
          }
        ]
      },
      {
        "id": 3,
        "title": "Profile Cache Hit Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "fingerprint_profile_cache_hit_total / (fingerprint_profile_cache_hit_total + fingerprint_profile_cache_miss_total)",
            "legendFormat": "Hit Rate"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "unit": "percentunit",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.8},
                {"color": "green", "value": 0.95}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Active Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "fingerprint_active_connections",
            "legendFormat": "Connections"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        }
      },
      {
        "id": 5,
        "title": "Behavior Signals by Risk Level",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (risk_level) (fingerprint_behavior_signals_total)",
            "legendFormat": "{{risk_level}}"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right"
          }
        }
      },
      {
        "id": 6,
        "title": "HTTP/2 Analysis Duration",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(fingerprint_http2_analysis_duration_ms_bucket[5m])",
            "legendFormat": "{{le}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "dataFormat": "tsbuckets"
      },
      {
        "id": 7,
        "title": "Total Fingerprints Generated",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(fingerprint_generation_total)",
            "legendFormat": "Total"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
        "options": {
          "colorMode": "value"
        }
      },
      {
        "id": 8,
        "title": "Browser Distribution",
        "type": "bargauge",
        "targets": [
          {
            "expr": "sum by (browser) (fingerprint_generation_total)",
            "legendFormat": "{{browser}}"
          }
        ],
        "gridPos": {"h": 8, "w": 18, "x": 6, "y": 24}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
